# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules.nosync/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & coverage
/coverage
.coverage
htmlcov/
.pytest_cache/

# next.js
/.next/
/out/
/build

# misc
.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment variables
.env
.env.local
.env.*.local
backend/.env
backend/.env.local
backend/.env.*.local
!.env.example
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python & backend
backend/.venv/
backend/.venv*/
.venv/
.venv*/
venv/
__pycache__/
*.py[cod]
*$py.class
*.so

# databases (SQLite / local test DBs)
*.sqlite
*.sqlite3
*.db
backend/*.db
backend/*.sqlite*

# Large ML model weight binaries (>100MB, cannot be committed to Git)
*.safetensors
*.bin
*.pt
*.pth
*.onnx

# Temporary archives
ezgif*.zip
*.zip
*.tar.gz
ezgif*/
public/images/sequence/
